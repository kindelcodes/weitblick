{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weitblick",
  "version": "0.4.0",
  "identifier": "de.weitblick.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Weitblick",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nils Kindel",
    "copyright": "© 2026 Nils Kindel",
    "license": "MIT",
    "homepage": "https://github.com/kindelcodes/weitblick",
    "category": "Productivity",
    "shortDescription": "Präsentationen auf einer zoombaren Leinwand",
    "longDescription": "Weitblick legt alle Inhalte auf eine große Leinwand. Rahmen markieren Ausschnitte, ein Pfad legt die Reihenfolge fest, und die Kamera fliegt weich von Rahmen zu Rahmen. Läuft vollständig offline.",
    "windows": {
      "wix": { "language": "de-DE" },
      "nsis": { "languages": ["German"], "installMode": "currentUser" }
    },
    "fileAssociations": [
      {
        "ext": ["weitblick"],
        "name": "Weitblick-Präsentation",
        "description": "Weitblick-Präsentation",
        "role": "Editor",
        "mimeType": "application/x-weitblick"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
